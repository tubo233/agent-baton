    {
      "id": "selftest",
      "name": "自测（不调用任何模型）",
      "vendor": "none",
      "kind": "test",
      "executables": [
        "python3",
        "python",
        "py"
      ],
      "env_hints": [],
      "known_locations": {},
      "version_args": [
        "--version"
      ],
      "models": {
        "method": "static",
        "static": [
          "5"
        ],
        "note": "模型参数填秒数"
      },
      "efforts": [],
      "skill_dirs": [],
      "headless": {
        "status": "verified",
        "prompt_via": "stdin",
        "args": [
          "-c",
          "import sys,time; sys.stdin.read(); time.sleep(float(sys.argv[1])); open('结果.txt','w',encoding='utf-8').write('OK selftest'); print('selftest done')",
          "{model}"
        ],
        "effort_args": [],
        "access": {
          "job": []
        },
        "cwd": "job",
        "log": "运行日志.txt"
      },
      "failure_patterns": {},
      "notes": "用来检查 dispatch.py 的启动、等待、停止是否正常，不花任何额度：dispatch.py run --agent selftest --model 5"
